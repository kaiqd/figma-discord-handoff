      "id": "f2d5d7e3-7c40-42e8-9f25-3c3a8d9a000b",
      "name": "Send message to Discord",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [2020, -80],
