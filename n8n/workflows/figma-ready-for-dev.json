            }
          ]
        }
      },
      "id": "5a4a1661-2a02-44b9-8df1-27d64c130009",
      "name": "New event?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1580, -80]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ 'https://api.figma.com/v1/files/' + encodeURIComponent($node['Deduplicate'].json.payload.file_key) }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "options": {
          "timeout": 10000
        }
      },
      "id": "cdbad2a5-59d4-4e33-9e54-6a0f56c3000e",
      "name": "Fetch Figma file metadata",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1800, -80],
      "continueOnFail": true,
      "credentials": {
        "httpHeaderAuth": {
          "name": "Hands On — Figma API Token"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const source = $node['Deduplicate'].json;\nconst event = source.payload;\nconst clean = (value, fallback, max = 1024) => {\n  const text = String(value ?? fallback).trim();\n  return text.slice(0, max) || fallback;\n};\nconst fileKey = clean(event.file_key, 'unknown-file', 200);\nconst nodeId = clean(event.node_id, '', 100);\nconst nodeQuery = nodeId ? `?node-id=${encodeURIComponent(nodeId.replace(':', '-'))}` : '';\nconst figmaUrl = `https://www.figma.com/design/${encodeURIComponent(fileKey)}/${nodeQuery}`;\nconst fileName = clean($json.name ?? event.file_name, `Figma file ${fileKey}`, 256);\nconst handoffBy = clean(event.triggered_by?.handle ?? event.triggered_by?.name, 'Unknown designer', 256);\nconst description = clean(event.change_message ?? event.description, 'No description provided.', 1024);\nconst relatedLinks = Array.isArray(event.related_links) ? event.related_links : [];\nconst fields = [\n  { name: 'File', value: fileName, inline: true },\n  { name: 'Handed off by', value: handoffBy, inline: true },\n  { name: 'Open in Figma', value: `[View design](${figmaUrl})`, inline: false }\n];\nif (relatedLinks.length) {\n  fields.push({ name: 'Related links', value: relatedLinks.slice(0, 5).map(link => `[${clean(link.name, 'Resource', 80)}](${link.url})`).join('\\n').slice(0, 1024), inline: false });\n}\nreturn [{ json: {\n  idempotencyKey: source.idempotencyKey,\n  discordPayload: {\n    embeds: [{\n      title: 'Ready for development',\n      url: figmaUrl,\n      description,\n      color: 5763719,\n      fields,\n      footer: { text: 'Hands On · From handoff to hands-on' }\n    }],\n    allowed_mentions: { parse: [] }\n  }\n} }];"
      },
      "id": "9a6f032d-b15a-43e2-83f4-51ca3c12000a",
      "name": "Build Discord message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1800, -80]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://discord.com/api/v10/channels/' + $env.DISCORD_CHANNEL_ID + '/messages' }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.discordPayload) }}",
