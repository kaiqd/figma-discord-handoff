    },
    {
      "parameters": {
        "jsCode": "const body = ($json.body && typeof $json.body === 'object') ? $json.body : $json;\nconst passcode = typeof body.passcode === 'string' ? body.passcode : '';\nconst { passcode: _redacted, ...safePayload } = body;\nconst expected = typeof $env.FIGMA_WEBHOOK_PASSCODE === 'string' ? $env.FIGMA_WEBHOOK_PASSCODE : '';\nreturn [{ json: { payload: safePayload, valid: Boolean(expected) && passcode === expected } }];"
      },
      "id": "3cfdd6b9-7d8a-45d2-9577-69f85a5f6f02",
      "name": "Validate passcode",
      "type": "n8n-nodes-base.code",
