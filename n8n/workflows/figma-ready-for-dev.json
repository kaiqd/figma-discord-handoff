          "name": "Hands On — Discord Bot"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const store = $getWorkflowStaticData('global');\nstore.processed = store.processed ?? {};\nconst idempotencyKey = $node['Build Discord message'].json.idempotencyKey;\nstore.processed[idempotencyKey] = { processedAt: new Date().toISOString(), discordMessageId: $json.id ?? null };\nreturn [{ json: { recorded: true, idempotencyKey, discordMessageId: $json.id ?? null } }];"
      },
      "id": "9b4f82c4-5e9a-4ccd-a51a-7bd8d3b1000c",
