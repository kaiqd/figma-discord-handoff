        }
      },
      "id": "c2e1ac72-a7c3-448c-990d-1b7e7b1c0b05",
      "name": "Acknowledge Figma",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [680, -80]
    },
    {
      "parameters": {
        "jsCode": "const { payload } = $json;\nif (payload.event_type === 'PING') return [];\nif (payload.event_type !== 'DEV_MODE_STATUS_UPDATE') return [];\nreturn [{ json: $json }];"
      },
      "id": "4b60fd1c-7452-4264-bb56-9f060ef70606",
      "name": "Route event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [920, -80]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.payload.status }}",
              "operation": "equals",
              "value2": "READY_FOR_DEV"
            }
          ]
        }
      },
      "id": "be2e56a2-7a76-42bc-bb7f-55792d3ea007",
      "name": "Filter READY_FOR_DEV",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1140, -80]
    },
    {
      "parameters": {
        "jsCode": "const event = $json.payload;\nconst idempotencyKey = JSON.stringify([event.webhook_id ?? '', event.event_type ?? '', event.file_key ?? '', event.node_id ?? '', event.status ?? '', event.timestamp ?? '']);\nconst store = $getWorkflowStaticData('global');\nconst processed = store.processed ?? {};\nreturn [{ json: { ...$json, idempotencyKey, duplicate: Boolean(processed[idempotencyKey]) } }];"
      },
      "id": "a0ad9f7e-dfeb-4862-84c4-8bfc09f50808",
      "name": "Deduplicate",
      "type": "n8n-nodes-base.code",
