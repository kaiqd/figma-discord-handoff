# Discord
DISCORD_APPLICATION_ID=
DISCORD_CHANNEL_ID=
DISCORD_BOT_TOKEN=

# Figma
FIGMA_TOKEN=
FIGMA_CONTEXT_TYPE=file
FIGMA_CONTEXT_ID=
# Opcional: use team-<id> ou organization-<id> para listar webhooks de todo o plano.
FIGMA_PLAN_API_ID=
FIGMA_WEBHOOK_PASSCODE=

# n8n / endpoint usado pelo Figma
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_PORT=5678
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=https://n8n.example.com/
FIGMA_WEBHOOK_ENDPOINT=https://n8n.example.com/webhook/figma-ready-for-dev
N8N_PROXY_HOPS=1
N8N_LOG_LEVEL=info
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=336
GENERIC_TIMEZONE=America/Fortaleza

# PostgreSQL
POSTGRES_DB=pg_n8ndb
POSTGRES_USER=pg_admin
POSTGRES_PASSWORD=pg_admin123
